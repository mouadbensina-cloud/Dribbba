# Copy this file to .env.local and fill in real values.
#
# The map + quartier data work with zero setup (static content, no DB) as
# long as NEXT_PUBLIC_MAPBOX_TOKEN is set. Ask AI needs COHERE_API_KEY.

# Mapbox — required for the map. Get a public token (starts with "pk.") at
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Cohere — server-side only, never exposed to the client. Required for the
# Ask AI screen to actually respond. Get a key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-key
# Optional: override the model used by /api/chat (defaults to command-r-plus-08-2024)
COHERE_MODEL=command-r-plus-08-2024

# Script-only — used by scripts/fetch-quartier-locations.ts to look up real
# coordinates for quartiers with no official boundary. The running app
# never reads this. Needs the Places API (or Geocoding API) enabled on
# your Google Cloud project.
GOOGLE_PLACES_API_KEY=your-google-places-key

# Not required for now — the app reads static data (see lib/staticData.ts)
# instead of Supabase. Fill these in only if you switch back to a live
# database; see README "Decisions I made".
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
