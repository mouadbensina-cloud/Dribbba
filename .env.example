# Copy this file to .env.local and fill in real values.
#
# The map + quartier data work with zero setup (static content, no DB) as
# long as NEXT_PUBLIC_MAPBOX_TOKEN is set. Ask AI needs ANTHROPIC_API_KEY.

# Mapbox — required for the map. Get a public token (starts with "pk.") at
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Anthropic — server-side only, never exposed to the client. Required for
# the Ask AI screen to actually respond.
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional: override the model used by /api/chat (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Not required for now — the app reads static data (see lib/staticData.ts)
# instead of Supabase. Fill these in only if you switch back to a live
# database; see README "Decisions I made".
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
